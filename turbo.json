{
  "$schema": "https://turborepo.com/schema.json",
  "dangerouslyDisablePackageManagerCheck": true,
  "tasks": {
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test": {
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  }
}
