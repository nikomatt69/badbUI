{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "badb",
  "description": "Badb: sito di gilda, app mobile, bot Discord e addon WoW collegati a un unico server centrale",
  "private": true,
  "type": "module",
  "version": "0.3.0",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --watch packages/server/src/index.ts",
    "web:dev": "bun run --cwd packages/web dev",
    "web:build": "bun run --cwd packages/web build",
    "mobile:dev": "bun run --cwd packages/mobile start",
    "discord:dev": "bun --watch packages/discord/src/index.ts",
    "companion:dev": "bun packages/companion/src/index.ts watch",
    "chat:dev": "bun packages/wow-chat/src/index.ts",
    "chat:package": "bun script/package-chat.ts",
    "seed": "bun packages/server/src/seed-cli.ts",
    "typecheck": "bun turbo typecheck",
    "test": "bun turbo test",
    "test:addon": "cd packages/addon && luajit tests/run.lua . && luajit tests/run_stub.lua && luajit tests/ui/run.lua .",
    "addon:package": "bun run script/package-addon.ts",
    "guild-addon:package": "bun run script/package-addon.ts guild",
    "start": "bun packages/server/src/index.ts",
    "mobile:build": "bun run --cwd packages/mobile build",
    "cloudflare:dev": "bun run web:build && wrangler dev",
    "cloudflare:build": "bun run release:package && bun run web:build && wrangler deploy --dry-run --outdir dist/cloudflare",
    "cloudflare:deploy": "bun run cloudflare:build && wrangler deploy",
    "cloudflare:test": "bun run cloudflare:build && node --test packages/cloudflare/test/worker.test.mjs",
    "companion:package": "bun script/package-companion.ts",
    "release:package": "bun run addon:package && bun run guild-addon:package && bun run companion:package && bun run chat:package && bun script/package-release.ts"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "1.4.4",
      "hono": "4.13.17",
      "typescript": "5.8.2",
      "zod": "4.6.7",
      "solid-js": "1.9.18",
      "vite": "8.3.7"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261109.1",
    "@types/bun": "catalog:",
    "eas-cli": "27.5.0",
    "miniflare": "5.20261109.0-beta",
    "prettier": "3.6.2",
    "turbo": "2.11.10",
    "typescript": "catalog:",
    "wrangler": "4.159.0"
  }
}
