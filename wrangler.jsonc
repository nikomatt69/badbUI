{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "badb-guild",
  "main": "packages/cloudflare/src/index.ts",
  "account_id": "eea5a4fefd4206e2ceaba1954557befc",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./packages/web/dist", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "GUILD", "class_name": "GuildServer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GuildServer"] }],
  "vars": { "BADB_TZ": "Europe/Rome" },
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 30000 },
}
