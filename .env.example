# Server centrale (packages/server)
PORT=4096
BADB_DB=./data/badb.sqlite
BADB_TZ=Europe/Rome
# Sito compilato, servito dal server centrale (percorso dalla radice del monorepo)
BADB_WEB=./packages/web/dist
# Origini ammesse per il sito (separate da virgola). Vuoto = stesso host.
BADB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Segreto condiviso con il bot Discord (packages/discord). Genera con: openssl rand -hex 32
BADB_BOT_SECRET=
# Webhook Discord per annunci (nuovi post, nuovi raid). Facoltativo.
BADB_DISCORD_WEBHOOK=

# Bot Discord (packages/discord)
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
BADB_SERVER=http://localhost:4096

# Sito (packages/web) e app (packages/mobile)
VITE_BADB_SERVER=http://localhost:4096
EXPO_PUBLIC_BADB_SERVER=http://localhost:4096
