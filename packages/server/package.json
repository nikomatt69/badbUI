{
  "name": "@badb/server",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "seed": "bun src/seed-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@badb/core": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
